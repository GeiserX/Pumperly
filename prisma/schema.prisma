generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model Station {
  id          String   @id @default(uuid()) @db.Uuid
  externalId  String   @map("external_id")
  country     String   @db.VarChar(2)
  name        String
  brand       String?
  address     String
  city        String
  province    String?
  stationType String   @default("fuel") @map("station_type") @db.VarChar(20)
  /// Highest single-connector power (kW) for EV chargers; null when unknown or not a charger.
  maxPowerKw  Int?     @map("max_power_kw") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  prices FuelPrice[]

  @@unique([externalId, country])
  @@map("stations")
}

model FuelPrice {
  id         BigInt   @id @default(autoincrement())
  stationId  String   @map("station_id") @db.Uuid
  fuelType   String   @map("fuel_type") @db.VarChar(20)
  price      Decimal  @db.Decimal(10, 3)
  currency   String   @default("EUR") @db.VarChar(3)
  /// When the upstream dated the price. NULL: dated by its source's last
  /// successful run in the station's country (ScrapeRun.lastSuccessAt).
  reportedAt DateTime? @map("reported_at") @db.Timestamptz
  source     String   @db.VarChar(50)
  /// EV only: fees on top of the per-kWh price, shaped as EvFees (src/types/station.ts).
  evFees     Json?    @map("ev_fees")

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, fuelType, source])
  @@map("fuel_prices")
}

/// When each source last finished a successful run in each country. Written in
/// the same transaction as that run's prices.
model ScrapeRun {
  country       String   @db.VarChar(2)
  source        String   @db.VarChar(50)
  lastSuccessAt DateTime @map("last_success_at") @db.Timestamptz

  @@id([country, source])
  @@map("scrape_runs")
}
