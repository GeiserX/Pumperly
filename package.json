{
  "name": "pumperly",
  "version": "1.19.4",
  "description": "Open-source energy route planner for fuel and electric vehicles. Self-hostable.",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
